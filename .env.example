# ---------------------------------------------------------------------------
# Dealer Digital — environment template
# Copy to .env locally. NEVER commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase, Neon, RDS, or local Postgres).
# Supabase pooler example:
#   postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealer_digital?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dealer_digital?schema=public"

# 32+ byte random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-secret-at-least-32-bytes"

# Public site URL (used for canonical links and document footers).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional integrations. Every one of these is OFF by default and the app is
# fully functional without them. Do not invent credentials.
# ---------------------------------------------------------------------------

# Object storage for vehicle photos and uploaded documents.
# Without it the app stores uploads on the local filesystem (dev only).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""   # SERVER-ONLY. Never expose to the browser.
# SUPABASE_STORAGE_BUCKET="dealer-documents"

# Traccar GPS (optional; never required to sell a vehicle).
# TRACCAR_BASE_URL="http://localhost:8082"
# TRACCAR_API_TOKEN=""
# TRACCAR_OSMAND_DEVICE_IDENTIFIER=""

# ---------------------------------------------------------------------------
# Market intelligence (MarketCheck). OPTIONAL, SERVER-ONLY.
#
# Without this key Analyze still works: the operator types the expected retail
# value by hand. With it, Analyze can price the car against live market
# evidence and pre-fill that figure.
#
# The key is read ONLY on the server (`process.env.MARKETCHECK_API_KEY`), is
# never sent to the browser, and must never be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# MARKETCHECK_API_KEY=""
# Market region used when no dealer ZIP is configured. Optional.
# MARKETCHECK_ZIP=""
# How long a retrieved market snapshot is reused before another API call, in
# minutes. Keep this generous: the dealership is a 2-5 car operation and every
# call is a paid request. Default is 1440 (24 hours).
# MARKETCHECK_CACHE_TTL_MINUTES="1440"

# ---------------------------------------------------------------------------
# Local operator provisioning (`npm run db:seed`). NAMES ONLY — never commit
# values. The seed refuses to run with NODE_ENV=production and has no default
# credentials, so an unset password is a hard failure rather than a weak login.
# ---------------------------------------------------------------------------
# SEED_OWNER_EMAIL="owner@example.com"
# SEED_OWNER_PASSWORD="a-long-unique-password"
# SEED_OWNER_NAME="Dealer Owner"
